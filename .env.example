# OpenDraft Configuration
# Copy this file to .env and add your API keys

# Required: At least one AI model API key
GOOGLE_API_KEY=your-gemini-api-key

# Optional: Additional models
# ANTHROPIC_API_KEY=your-claude-api-key
# OPENAI_API_KEY=your-openai-api-key

# Optional: Fallback Gemini API keys for rate limit resilience
# GOOGLE_API_KEY_FALLBACK=your-fallback-key
# GOOGLE_API_KEY_FALLBACK_2=your-second-fallback-key
# GOOGLE_API_KEY_FALLBACK_3=your-third-fallback-key

# --- Citation verification ---------------------------------------------
# Multi-source confirmation and claim-level verification are ON by default.
# These variables only need setting to loosen or disable the defaults.

# Claim-level verification: is each source actually about what it is cited for?
# ENABLE_CLAIM_VERIFICATION=true
# Remove confidently off-topic citations (false = report only, change nothing)
# CLAIM_VERIFICATION_DROP_IRRELEVANT=true
# Judge confidence required before an IRRELEVANT verdict removes a citation
# CLAIM_VERIFICATION_MIN_CONFIDENCE=0.7

# Topical relevance floor used by the keyword-based quality filter
# CITATION_RELEVANCE_THRESHOLD=0.30

# Disable Semantic Scholar if it rate-limits you. NOTE: this leaves only
# Crossref and OpenAlex to confirm against, which is exactly the 2 that
# multi-source confirmation requires by default, so any further reduction
# will make CitationResearcher refuse to start.
# ENABLE_SEMANTIC_SCHOLAR=true

# Multi-source confirmation itself (require_multi_source, min_confirming_sources,
# allow_unconfirmed_web_sources, enable_llm_fallback) is set in code, per
# CitationResearcher instance, not via environment variables.
